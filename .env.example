# Semantic Scholar API key (optional, but recommended for higher rate limits)
# https://www.semanticscholar.org/product/api#api-key
SEMANTIC_SCHOLAR_API_KEY=

# OpenAlex mailto (polite pool for faster responses)
# https://docs.openalex.org/how-to-use-the-api/rate-limits-and-authentication
OPENALEX_EMAIL=

# Web UI のパスワード（任意）。設定すると画面でログインが必要になる。
# Cloudflare Tunnel など外部から開けるようにする場合は必須（12文字以上を推奨）。
LITKIT_PASSWORD=
